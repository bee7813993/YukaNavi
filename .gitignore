# ===== Unity 標準 (github/gitignore Unity.gitignore ベース) =====
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/.utmp/

# ビルド成果物
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Unity 生成ファイル
sysinfo.txt
crashlytics-build.properties
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Addressables / StreamingAssets の自動生成物
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ===== IDE =====
.vs/
.idea/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.booproj
*.svd
*.pidb
*.mdb
*.opendb
*.VC.db

# ===== OS =====
.DS_Store
Thumbs.db

# ===== Live2D Cubism SDK (再配布不可のためコミットしない) =====
# 導入手順は README.md を参照
/[Aa]ssets/Live2D/
/[Aa]ssets/Live2D.meta

# ===== サンプルスキンの生成物 (make_zip.ps1 で作る。実体は seasonal/ の流用) =====
/art/sample_skins/*/*.zip

# ===== 手元の作業ファイル (リポジトリには含めない) =====
# Unity がクラッシュ復旧時に作るシーンの退避
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
# ストア審査資料などの参照用 PDF (ルート直下に置いたもの)
/*.pdf
# セッション間の引き継ぎメモ (一時的な作業メモ)
/docs/SESSION_HANDOFF_*.md
