  "talk": [
    "今日はどんな曲を歌いましょうか？",
    "聴きたい曲が決まったら、私に教えてくださいね。",
    "あなたのリクエスト、楽しみにしています。",
    "音量や接続も、ここから確認できますよ。",
    "次の一曲も、一緒に楽しみましょう。"
  ],
  "talk_morning": [
    "おはようございます。朝の一曲、さわやかに始めましょう。",
    "今日の気分に合う曲を探してみませんか？"
  ],
  "talk_evening": [
    "お疲れさまです。夕暮れに似合う曲はいかがですか？",
    "一日の締めくくりに、好きな歌をどうぞ。"
  ],
  "talk_night": [
    "こんばんは。静かな夜のプレイリストも素敵ですね。",
    "夜更かしはほどほどに、もう一曲だけ楽しみましょう。"
